# ---------------------------------------------------------------------------
# Variables PUBLIQUES du front (préfixe VITE_ : elles finissent dans le JS
# envoyé aux navigateurs). N'y mets JAMAIS une clé secrète : ni la clé
# service_role, ni une clé Brevo, ni le secret Turnstile.
# Copie ce fichier en .env pour le développement local ; en production,
# renseigne-les dans Vercel (Settings > Environment Variables).
# ---------------------------------------------------------------------------

# URL du projet Supabase (Project Settings > API > Project URL).
# Vide : le site fonctionne, le formulaire de liste d'attente est désactivé
# avec un message et le compteur n'est pas affiché.
VITE_SUPABASE_URL=
# Clé publique « anon » ou « publishable » (Project Settings > API Keys).
VITE_SUPABASE_ANON_KEY=
# Clé de SITE Cloudflare Turnstile (publique). Vide : pas de vérification
# anti-robot côté navigateur (à garder cohérent avec TURNSTILE_SECRET_KEY
# côté Edge Function : les deux renseignés, ou les deux vides).
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Variables de BUILD (lues par scripts/build.mjs, jamais envoyées au navigateur)
# ---------------------------------------------------------------------------
# URL publique du site, sans « / » final (canonical, sitemap, robots.txt).
# Sur Vercel, à défaut, l'URL de production du projet est utilisée.
SITE_URL=http://localhost:4173
# 1 = autoriser un build de PRODUCTION Vercel malgré des {{À COMPLÉTER}}
# (déconseillé : les mentions légales seraient incomplètes).
# ALLOW_PLACEHOLDERS=

# ---------------------------------------------------------------------------
# Les SECRETS de l'Edge Function waitlist-join ne vont PAS ici :
# voir supabase/functions/.env.example (supabase secrets set).
# ---------------------------------------------------------------------------

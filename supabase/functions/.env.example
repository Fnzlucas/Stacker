# Secrets de l'Edge Function waitlist-join.
# En production : `supabase secrets set --env-file supabase/functions/.env`
# (ce fichier .env n'est jamais versionné). SUPABASE_URL et
# SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase.

# URL publique du site (liens de parrainage dans l'email et la réponse)
SITE_URL=https://stacker.example
# Origines autorisées à appeler la fonction (séparées par des virgules)
ALLOWED_ORIGINS=https://stacker.example,http://localhost:5173,http://localhost:4173
# Sel secret pour hacher les adresses IP du rate limit (chaîne aléatoire,
# 16 caractères minimum : `openssl rand -hex 32`)
RATE_LIMIT_PEPPER=
# Clé SECRÈTE Cloudflare Turnstile. Vide : vérification anti-robot désactivée
# (le rate limit reste actif). À garder cohérent avec VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# Brevo transactionnel. Vide : mode « log » (aucun email envoyé, l'événement
# est journalisé sans donnée personnelle).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Stacker
# Adresse affichée dans l'email pour exercer ses droits
CONTACT_EMAIL=
